---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>

/* ul {
    display: flex;
    list-style: none;
    gap: 20px;
    padding-bottom: 20px;
    overflow-x: auto;
   
   
    >* {
    display: block;
    background-color: lightgray;
    padding: 16px;
    border-radius: 20px;
    width: 350px;
    flex-shrink: 0;
   
    }
  } */

ul {
  list-style: none;

  display: flex;
  gap: var(--card-gap);

  scroll-padding-inline: 2rem;
  scroll-snap-type: inline mandatory;
  overflow-x: auto;
  padding: 1.5rem 1rem;

  }

  li{
  flex-basis: 45%;
  flex-shrink: 0;
  scroll-snap-align: start;
  scroll-snap-stop: always;

  background: var(--card-background);
  color: var(--card-text-color);

  
  padding: var(--card-padding);
  border-radius: var(--card-border-radius);

  }



</style>
